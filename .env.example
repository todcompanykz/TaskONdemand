DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=tod
DB_PORT=5432
DB_BIND_ADDRESS=127.0.0.1

REDIS_PORT=6379

RABBITMQ_USER=admin
RABBITMQ_PASS=admin
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

BACKEND_PORT=3001
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

