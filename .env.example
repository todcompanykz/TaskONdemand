DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=tod
# Host port mapped to Postgres (container still uses 5432). On Windows if 5432 is reserved/blocked, use 5433.
DB_PORT=5432
DB_BIND_ADDRESS=127.0.0.1

REDIS_PORT=6379

RABBITMQ_USER=admin
RABBITMQ_PASS=admin
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

BACKEND_PORT=3001
# Host port for Next.js (container still listens on 3000). Default 3005 avoids clash with local `next dev` on 3000.
FRONTEND_PORT=3005
FRONTEND_URL=http://localhost:3005

# Full stack (nginx + metrics + n8n); from repo root:
# docker compose -f docker-compose.full.yml --env-file .env up -d --build

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- Optional: full infra (monitoring + n8n); see env/.env.monitoring.example ---
# GRAFANA_PORT=3010
# GRAFANA_ROOT_URL=http://localhost/grafana
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093
# N8N_PORT=5678
# N8N_ENCRYPTION_KEY=change-me-32-chars-minimum
# AI_MODEL used by n8n→opal (LiteLLM). Prefix openrouter/ routes correctly without a config.yaml.
# AI_MODEL=openrouter/google/gemma-3-27b-it:free
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id
OPENAI_API_KEY=
# Free provider default (OpenRouter). Put your free-tier key above.
OPENAI_MODEL=google/gemma-3-27b-it:free
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TIMEOUT_MS=12000
OPENROUTER_HTTP_REFERER=http://localhost:3005
OPENROUTER_X_TITLE=TaskONdemand
# LiteLLM (opal): n8n sends Bearer token = OPAL_MASTER_KEY by default (set both to the same secret).
# OPENAI_API_KEY is the upstream key (OpenAI/OpenRouter), not the Bearer n8n uses.
# N8N_TO_OPAL_BEARER=   # optional; only if n8n must use a different Bearer than OPAL_MASTER_KEY
# AI_API_BASE_URL=http://opal:4000/v1
# AI_MODEL=google/gemma-3-27b-it:free
# OPAL_PORT=4000
# OPAL_MASTER_KEY=change-me-opal-master-key
