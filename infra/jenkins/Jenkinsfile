pipeline {
  agent any

  environment {
    COMPOSE_FILE    = "infra/docker/docker-compose.base.yml"
    COMPOSE_PROJECT = "jenkins-ci-${env.BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install') {
      steps {
        dir('apps/backend') {
          sh 'npm install'
        }
      }
    }

    stage('Backend tests') {
      steps {
        dir('apps/backend') {
          sh 'npm test --passWithNoTests || true'
        }
      }
    }

    stage('Build docker images') {
      steps {
        sh 'docker compose -p $COMPOSE_PROJECT -f $COMPOSE_FILE build backend frontend'
      }
    }

    stage('Smoke check') {
      steps {
        sh 'docker compose -p $COMPOSE_PROJECT -f $COMPOSE_FILE up -d postgres redis backend'
        sh 'sleep 25'
        sh 'docker compose -p $COMPOSE_PROJECT -f $COMPOSE_FILE exec -T backend wget -qO- http://localhost:3001/health || true'
      }
    }
  }

  post {
    always {
      sh 'docker compose -p $COMPOSE_PROJECT -f $COMPOSE_FILE down -v || true'
    }
    success {
      echo 'Build passed!'
    }
    failure {
      echo 'Build failed!'
    }
  }
}
