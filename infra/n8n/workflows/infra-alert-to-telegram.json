{
  "name": "Infra Alert to Telegram",
  "nodes": [
    {
      "parameters": {
        "path": "infra-alert",
        "responseMode": "lastNode"
      },
      "id": "Webhook1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [260, 300]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{ ($json.alerts && $json.alerts.length) ? $json.alerts.map(a => (a.annotations && (a.annotations.description || a.annotations.summary)) || (a.labels && a.labels.alertname) || 'Alert').join('\\n---\\n') : ($json.message || 'Infrastructure alert') }}"
      },
      "id": "Telegram1",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
