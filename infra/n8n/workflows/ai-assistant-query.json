{
  "name": "AI Assistant Query",
  "nodes": [
    {
      "parameters": {
        "path": "ai-assistant",
        "responseMode": "responseNode"
      },
      "id": "Webhook1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 260]
    },
    {
      "parameters": {
        "url": "={{$env.AI_API_BASE_URL}}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.AI_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "jsonBody": "={\"model\":($env.AI_MODEL || \"gpt-4o-mini\"),\"messages\":[{\"role\":\"system\",\"content\":\"You are TaskOnDemand infrastructure assistant. Keep responses concise and actionable.\"},{\"role\":\"user\",\"content\":$json.body.prompt}],\"temperature\":0.2}"
      },
      "id": "HttpRequest1",
      "name": "AI Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 260]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const completion = $json;\nconst answer = completion?.choices?.[0]?.message?.content ?? \"No response\";\nreturn {\n  answer,\n  model: completion?.model ?? ($env.AI_MODEL || \"unknown\"),\n  usage: completion?.usage ?? null,\n  trace: {\n    provider_base_url: $env.AI_API_BASE_URL,\n    requested_at: new Date().toISOString()\n  }\n};"
      },
      "id": "Code1",
      "name": "Normalize Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 260]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}"
      },
      "id": "Respond1",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [930, 260]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "AI Request", "type": "main", "index": 0 }]]
    },
    "AI Request": {
      "main": [[{ "node": "Normalize Response", "type": "main", "index": 0 }]]
    },
    "Normalize Response": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  }
}
